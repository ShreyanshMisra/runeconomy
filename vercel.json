{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd site && npm ci && npm run build && npm run check",
  "outputDirectory": "site/dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/getting-started/", "destination": "/start/", "permanent": true },
    { "source": "/skill/", "destination": "/agents/", "permanent": true },
    { "source": "/how-it-works/", "destination": "/articles/how-runeconomy-works/", "permanent": true }
  ]
}
