{
  "$id": "runeconomy.cli.experiment-run.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Completed experiment run. Exit 3 when --require-verified is set and the verdict is not verified.",
  "properties": {
    "artifacts": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "freeze": {
      "properties": {
        "record_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "not_frozen",
            "intact",
            "drifted"
          ]
        }
      },
      "required": [
        "record_sha256",
        "status"
      ],
      "type": "object"
    },
    "mode": {
      "enum": [
        "static_request",
        "agent_process"
      ]
    },
    "output_schema": {
      "const": "runeconomy.cli.experiment-run.v1"
    },
    "require_verified": {
      "type": "boolean"
    },
    "result": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "verified",
        "regression",
        "inconclusive",
        "invalid",
        "unknown"
      ]
    },
    "verified": {
      "type": "boolean"
    }
  },
  "required": [
    "artifacts",
    "checkpoint",
    "freeze",
    "mode",
    "output_schema",
    "require_verified",
    "result",
    "verdict",
    "verified"
  ],
  "title": "runeconomy experiment-run --json output, version 1",
  "type": "object"
}
