            "tools": {"$fixture": "INCIDENT_TOOLS"},
            "tool_choice": "none"
          }
        },
        "candidate": {
          "request_transform": {"kind": "canonicalize_tools"},
          "request": {
            "instructions": "You are an incident-response routing agent. Choose the single best first diagnostic tool from the supplied catalog. Do not call a tool. Return only its exact tool name and no explanation.",
            "input": "The checkout-api error rate rose from 0.3% to 12% four minutes after a deployment completed. The changed code is on the failing request path. Database and payment-provider latency are healthy, and CPU utilization is 42%. Which diagnostic tool must be used first?",
            "tools": {"$fixture": "INCIDENT_TOOLS"},
